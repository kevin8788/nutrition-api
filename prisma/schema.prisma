generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           BigInt         @id @default(autoincrement())
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  first_name   String?        @db.VarChar
  last_name    String?        @db.VarChar
  username     String?        @db.VarChar
  email        String?        @db.VarChar
  dob          DateTime?      @db.Date
  last_login   DateTime?      @db.Date
  gender       String?        @db.VarChar
  is_active    Boolean?       @default(true)
  google_uid   String?        @db.VarChar
  settings     settings[]
  user_profile user_profile[]
  planned_workouts planned_workout[]
  workout_sessions workout_session[]
  weekly_goal      weekly_goal[]

  @@map("users")
}

model planned_workout {
  id               BigInt            @id @default(autoincrement())
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  user_id          BigInt
  title            String            @db.VarChar
  description      String?
  workout_type     String            @db.VarChar
  scheduled_date   DateTime          @db.Date
  duration_minutes Int
  intensity        String?           @db.VarChar
  warmup_seconds   Int?
  status           String            @default("pending") @db.VarChar
  users            User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workout_sessions workout_session[]

  @@index([user_id, scheduled_date])
}

model workout_session {
  id                 BigInt           @id @default(autoincrement())
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  user_id            BigInt
  planned_workout_id BigInt?
  workout_type       String           @db.VarChar
  status             String           @default("in_progress") @db.VarChar
  is_indoor          Boolean          @default(false)
  started_at         DateTime         @default(now()) @db.Timestamptz(6)
  ended_at           DateTime?        @db.Timestamptz(6)
  duration_seconds   Int              @default(0)
  distance_km        Float            @default(0)
  avg_speed_kmh      Float?
  calories           Int              @default(0)
  effort_rating      Int?             @db.SmallInt
  users              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  planned_workout    planned_workout? @relation(fields: [planned_workout_id], references: [id], onDelete: SetNull)

  @@index([user_id, started_at])
}

model weekly_goal {
  id                 BigInt    @id @default(autoincrement())
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @db.Timestamptz(6)
  user_id            BigInt    @unique
  workouts_target    Int       @default(3)
  minutes_target     Int       @default(60)
  distance_target_km Float     @default(10)
  users              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model settings {
  id                        BigInt   @default(autoincrement())
  created_at                DateTime @default(now()) @db.Timestamptz(6)
  user_id                   BigInt
  language                  String?  @default("en") @db.VarChar
  dark_mode                 Boolean? @default(false)
  notifications_enabled     Boolean?
  audio_cues_enabled        Boolean?
  voice_coaching_enabled    Boolean?
  location_tracking_enabled Boolean?
  weight_unit               String?  @db.VarChar
  height_unit               String?  @db.VarChar
  distance_unit             String?  @db.VarChar
  updated_at                String?  @db.VarChar
  users                     User     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@id([id, user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_profile {
  id                    BigInt    @id @default(autoincrement())
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  user_id               BigInt?
  age                   Int?      @db.SmallInt
  weight                Float?
  height                Float?
  activity_level        String?   @db.VarChar
  daily_walking_minutes BigInt?
  has_run_before        Boolean?
  days_per_week         Int?      @db.SmallInt
  preferred_location    String?   @db.VarChar
  goal_type             String?   @db.VarChar
  intensity_preference  String?   @db.VarChar
  updated_at            DateTime? @db.Date
  users                 User?     @relation(fields: [user_id], references: [id])
}
